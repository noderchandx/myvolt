rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write data is owned by the requesting user.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      allow read: if request.auth.uid != null && get(/databases/$(database)/documents/users/$(userId)).data.isActive == true;
    }

    // Users can only create/update their own profile
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
    }

    // Files collection - only owner can read/write
    match /files/{fileId} {
      // Owner can do everything
      allow read, write, delete: if request.auth.uid == resource.data.userId;
      
      // Allow creation only by authenticated users
      allow create: if request.auth.uid != null && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.size <= 104857600; // 100MB max
      
      // Anyone with link can read shared files
      allow read: if resource.data.shared == true;
    }

    // Shared files (public access)
    match /shared/{fileId} {
      allow read: if true;
      allow write, delete: if request.auth.uid == resource.data.userId;
    }

    // Admin collection
    match /admin/{adminId} {
      allow read, write: if request.auth.uid == adminId && 
                           get(/databases/$(database)/documents/users/$(adminId)).data.isAdmin == true;
    }

    // Activity logs
    match /logs/{logId} {
      allow create: if request.auth.uid != null;
      allow read: if request.auth.uid == resource.data.userId || 
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Settings (global)
    match /settings/{settingId} {
      allow read: if request.auth.uid != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
